# NOTE: THIS IS NOT A SECRETS FILE, IT IS A CONFIG FILE AND SAFE TO BE COMMITTED

# Config for the firebase/delete-user-data extension (instance: delete-user-data).
# Fires on Firebase Auth account deletion and removes configured per-uid server
# data. The current iOS "Delete all data" flow deliberately preserves its
# anonymous Auth user, so that local reset does not trigger this extension.
# Deploy with: firebase deploy --only extensions

# Delete the per-user rate-limit doc. {UID} is substituted with the deleted uid.
# Note: pregen_cache/{UID} is not currently configured here; track that policy
# decision in docs/operations/release-checklist.md.
FIRESTORE_PATHS=user_rate_limits/{UID}

# The user_rate_limits doc has no subcollections, so a shallow delete is sufficient.
FIRESTORE_DELETE_MODE=shallow

# Only delete the explicit path above — no auto-discovery, no RTDB/Storage/search.
ENABLE_AUTO_DISCOVERY=no
RTDB_PATHS=
STORAGE_PATHS=
SEARCH_FUNCTION=
